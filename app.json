{
  "expo": {
    "name": "Agriguardian",
    "slug": "agriguardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/for_app/logo.png",
    "scheme": "agriguardian",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/for_app/foregroundImage.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ayan_shaikh786.agriguardian"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/for_app/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/for_app/splash_screen.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bf70f700-444d-445f-94ca-82cdfcb52032"
      }
    }
  }
}